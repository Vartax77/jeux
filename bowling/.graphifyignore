# .graphifyignore — exclut les bibliothèques externes du graphe de connaissances.
# Syntaxe gitignore complète (négation !, globs **, / final pour un dossier).
#
# Restent analysés : js/, css/, tests/, index.html, manette.html, sw.js,
# les manifestes, README.md, CAHIER-DES-CHARGES.md

# --- Vendor de ce dépôt (three.js, cannon-es, PeerJS, qrcode-generator) ---
lib/

# --- Les mêmes bibliothèques, par nom, si elles sont un jour déplacées ---
three.core.js
three.module.js
three.min.js
OrbitControls.js
RoomEnvironment.js
cannon-es.js
peerjs.js
peerjs.min.js
qrcode.js
qrcode-generator.js
**/jsm/

# --- Tout fichier minifié ou bundlé : vendor par nature ---
*.min.js
*.min.mjs
*.min.css
*.bundle.js
*.map

# --- Binaires sans contenu analysable ---
icones/

# --- Emplacements vendor habituels, si ajoutés plus tard ---
node_modules/
bower_components/
vendor/
third_party/
dist/
build/

# --- Sorties graphify : jamais une source ---
graphify-out/
